PORT=8080
DATABASE_URL=jdbc:postgresql://localhost:5432/mrbiryani
DATABASE_USERNAME=mrbiryani
DATABASE_PASSWORD=mrbiryani
# At least 32 bytes. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-of-32-plus-chars
JWT_ISSUER=mr-biryani-api
JWT_AUDIENCE=mr-biryani-clients
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=14d
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173
# Must be true in production (HTTPS)
COOKIE_SECURE=false
# Seed only: initial Admin, created at startup if no active Admin exists
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe-Admin-123
SEED_BRANCH_CODE=MAIN
SEED_BRANCH_NAME=Mr. BIRIYANI Main Branch
API_DOCS_ENABLED=true
# Assistant: leave empty to run without a model (answers come from quoted, cited passages)
ANTHROPIC_API_KEY=
CHAT_ENABLED=true

# Zoho Payments sandbox (test mode). Fill these in from the Zoho Payments developer console.
ZOHO_PAYMENTS_BASE_URL=https://paymentssandbox.zoho.in
ZOHO_PAYMENTS_ACCOUNT_ID=
ZOHO_PAYMENTS_ACCESS_TOKEN=
ZOHO_PAYMENTS_SUCCESS_URL=
ZOHO_PAYMENTS_FAILURE_URL=
ZOHO_PAYMENTS_WEBHOOK_SECRET=
